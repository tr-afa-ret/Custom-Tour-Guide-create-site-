# Copy this file to .env and fill in your keys.
# .env is git-ignored and is NOT part of the website (never upload it).

# Azure AI Speech (voice ru-RU-SvetlanaNeural). Region of your Speech resource, e.g. westeurope
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ElevenLabs. The key needs the "Text to Speech" and "Voices: read" permissions.
ELEVENLABS_API_KEY=
# Voice to use for the site; find one with: python tools/make_audio.py --list-voices
ELEVENLABS_VOICE_ID=
# Optional, default eleven_multilingual_v2
ELEVENLABS_MODEL=
